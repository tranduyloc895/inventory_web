# =============================================================================
# .gitignore – Polyglot Persistence Demo
# =============================================================================

# Environment files (NEVER commit real credentials)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.spec
.venv/
venv/
env/
.eggs/

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Docker
.dockerignore

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Coverage / Test artifacts
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Desktop.ini
