# =============================================================================
# Environment Variables – Polyglot Persistence Demo
# Copy this file to .env and fill in your database connection details.
# =============================================================================

# Application
APP_NAME=polyglot-crud-api
APP_ENV=production
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL – Core product catalog (relational, ACID)
POSTGRES_HOST=10.0.2.174
POSTGRES_PORT=5432
POSTGRES_DB=polyglot_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=08092005Loc

# MySQL – Orders & sales (relational, reporting)
MYSQL_HOST=10.0.2.202
MYSQL_PORT=3306
MYSQL_DB=polyglot_db
MYSQL_USER=inventory_user
MYSQL_PASSWORD=08092005Loc

# MongoDB – Product event history (flexible schema, append-only)
MONGO_HOST=10.0.2.69
MONGO_PORT=27017
MONGO_DB=polyglot_events
MONGO_USER=inventory_user
MONGO_PASSWORD=08092005Loc
MONGO_AUTH_SOURCE=admin

# Redis – Cache layer (in-memory, TTL-based)
REDIS_HOST=10.0.2.236
REDIS_PORT=6379
REDIS_PASSWORD=ZDmY3WUknY8a6bkh7ylOzFt2QWa8BuG
REDIS_DB=0
CACHE_TTL=300

# CORS – Comma-separated allowed origins for the API
# Thay <VM_IP> bằng IP hoặc domain của VM Frontend (VM 2)
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL – Frontend build-time setting
#
# Docker/Production: để TRỐNG ("") → Frontend dùng relative URL,
#   Nginx sẽ proxy /api/ và /ready về backend container.
#
# Local dev (npm run dev): đặt là http://localhost:8000
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=
