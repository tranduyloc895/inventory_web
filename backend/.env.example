APP_NAME=polyglot-crud-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL - Core product data
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=polyglot_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# MySQL - Orders & sales
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=polyglot_orders
MYSQL_USER=
MYSQL_PASSWORD=

# MongoDB - Event/audit history
MONGO_HOST=
MONGO_PORT=27017
MONGO_DB=polyglot_events
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Redis - Cache layer
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
